{
    "layer": "top",
    "position": "top",
    "height": 38,
    "spacing": 0,
    "reload_style_on_change": true,
    "fixed-center": true,
    // Module Placement
    "modules-left": [
        "niri/workspaces",
        "group/systray",
        "custom/left"
    ],
    "modules-center": [
        "custom/right",
        "group/datetime",
        "custom/browsers",
        "custom/micstat",
        "custom/notification",
        "custom/left"
    ],
    "modules-right": [
        "custom/right",
        "group/syshealth",
        "custom/sep2",
        "custom/extDrive",
        "custom/simpleNote",
        "custom/sep2",
        "custom/tux"
    ],
    "include": [
        "~/.config/waybar/config.d/built-in-modules.jsonc",
        "~/.config/waybar/config.d/custom-modules.jsonc",
        "~/.config/waybar/config.d/groups.jsonc"
    ]
}