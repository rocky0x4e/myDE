{
    "layer": "top",
    "position": "top",
    "height": 38,
    "spacing": 0,
    "reload_style_on_change": true,
    "fixed-center": true,
    "modules-left": [
        "group/syshealth",
        "custom/sep",
        "tray"
    ],
    "modules-center": [
        "group/datetime",
        "mpris",
        "niri/workspaces"
    ],
    "modules-right": [
        "custom/browsers",
        "custom/micstat",
        "privacy",
        "image#marko",
        "image#g1",
        "image#tux"
    ],
    "include": [
        "~/.config/waybar/modules.jsonc",
        "~/.config/waybar/groups.jsonc"
    ]
}