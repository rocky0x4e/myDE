{
    "group/syshealth": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 500,
            "children-class": "syshc",
            "transition-left-to-right": true
        },
        "modules": [
            "cpu",
            "battery",
            "memory"
        ]
    },
    "group/datetime": {
        "orientation": "inherit",
        // "drawer": {
        //     "transition-duration": 500,
        //     "transition-left-to-right": false
        // },
        "modules": [
            "clock#date",
            "clock#time"
        ]
    }
}