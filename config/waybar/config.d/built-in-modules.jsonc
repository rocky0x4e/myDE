{
    // Module Definitions
    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 24,
        "tooltip-format": "{title}",
        "on-click": "activate",
        "on-click-middle": "close",
        "bar-css-states": true
    },
    "niri/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "focused": "",
            "active": "",
            "default": "",
            "empty": ""
        }
    },
    "clock#time": {
        "format": "{:%H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "format": {
                "today": "<span color='#75f1fa'><b>{}</b></span>"
            }
        }
    },
    "clock#date": {
        "format": "{:%a, %b %d}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "format": {
                "today": "<span color='#75f1fa'><b>{}</b></span>"
            }
        }
    },
    "cpu": {
        "format": "<span size='x-large'></span> {usage}%",
        "interval": 5,
        "tooltip": true
    },
    "memory": {
        "format": "<span size='x-large'></span> {}%",
        "interval": 15,
        "on-click": "showRamStat"
    },
    "network": {
        "format-wifi": " {essid}",
        "format-ethernet": "󰈀 {ipaddr}",
        "format-disconnected": "󰖪 Disconnected",
        "tooltip-format": "{ifname} via {gwaddr}"
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "events": {
            "on-discharging-warning": "dunstify 'Battery low' 'Battery is under 30%! CHARGE NOW !!!' -u critical"
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󱐋 {capacity}%",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ]
    },
    "tray": {
        "icon-size": 24, // Adjust icon size to fit your bar height
        "spacing": 10 // Pixels of space between each icon
    },
    "image#browser": {
        "size": 32,
        "multiple": true,
        "tooltip": true,
        "exec": "/home/rocky/.config/waybar/scripts/browser2.py showIcon",
        "return-type": "json",
        "interval": "once",
        "marker": "normal",
        "on-click": "/home/rocky/.config/waybar/scripts/browser2.py open",
        "on-click-middle": "/home/rocky/.config/waybar/scripts/browser2.py change",
        "on-click-right": "/home/rocky/.config/waybar/scripts/browser2.py select"
    },
    "image#tux": {
        "path": "/home/rocky/.local/share/icons/wmicons/512x512/apps/linux.png",
        "interval": "once",
        "size": 32,
        "on-click": "fuzzel -a top-right",
        "on-click-right": "OPTIONS='-a top-right' controlCenter",
        "on-double-click": "pkill -SIGUSR2 waybar"
    },
    "orders": {
        "input": 0
    }
}