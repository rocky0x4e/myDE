{
    // Module Definitions
    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 24,
        "tooltip-format": "{title}",
        "on-click": "activate",
        "on-click-middle": "close"
    },
    "niri/workspaces": {
        "format": "{icon}",
        "format-icons": {
            // You can use different icons for the workspace states
            "focused": "",
            "active": "",
            "default": "",
            "empty": "•"
        }
    },
    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "format": {
                "today": "<span color='#75f1fa'><b>{}</b></span>"
            }
        }
    },
    "clock#date": {
        "format": "{:%a, %b %d}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "format": {
                "today": "<span color='#75f1fa'><b>{}</b></span>"
            }
        }
    },
    "cpu": {
        "format": "<span size='x-large'></span> {usage}%",
        "interval": 5,
        "tooltip": true
    },
    "memory": {
        "format": "<span size='x-large'></span> {}%",
        "interval": 15,
        "on-click": "showRamStat"
    },
    "network": {
        "format-wifi": " {essid}",
        "format-ethernet": "󰈀 {ipaddr}",
        "format-disconnected": "󰖪 Disconnected",
        "tooltip-format": "{ifname} via {gwaddr}"
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "events": {
            "on-discharging-warning": "dunstify 'Battery low' 'Battery is under 30%! CHARGE NOW !!!' -u critical"
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󱐋 {capacity}%",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ]
    },
    "tray": {
        "icon-size": 24, // Adjust icon size to fit your bar height
        "spacing": 10 // Pixels of space between each icon
    }
}